PORT=5000
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=student_events
DB_USER=app_user
DB_PASSWORD=app_password
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Local mock SMTP (Mailpit, started by docker compose). Its web inbox is http://localhost:8025.
# Any username/password is accepted, so the demo receipts work without an external sandbox.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=mailpit
SMTP_PASSWORD=mailpit
SMTP_FROM=no-reply@campushub.local

# To send real emails instead, replace the five SMTP_* lines above with your Mailtrap sandbox:
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=your-mailtrap-username
# SMTP_PASSWORD=your-mailtrap-password
# SMTP_FROM=no-reply@campushub.local
